# =========================================================
# Phongtzzz Homestay Booking - single root env
# Copy this file to .env and edit values before docker compose up.
# =========================================================

# Project / local ports
PROJECT_NAME=phongtzzz
LANDING_PORT=5173
ADMIN_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Public domains used by Cloudflare Tunnel
# Set these to your real domain/subdomains.
PUBLIC_FRONTEND_URL=https://your-domain.com
PUBLIC_ADMIN_URL=https://admin.your-domain.com
PUBLIC_API_URL=https://api.your-domain.com

# Frontend build-time API URLs
# Use http://localhost:8000/api for local-only testing, or your public API domain for production/tunnel.
VITE_API_URL=https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# Cloudflare Tunnel
# Create a Cloudflare Tunnel token and paste it here.
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_DB=phongtzzz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/phongtzzz

# FastAPI / Auth
APP_NAME=Phongtzzz Booking API
ENVIRONMENT=production
SECRET_KEY=change-this-secret-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@phongtzzz.local
ADMIN_PASSWORD=admin123456

# CORS
# Backend already allows PUBLIC_FRONTEND_URL and PUBLIC_ADMIN_URL.
# Add extra origins separated by comma if needed.
CORS_EXTRA_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Booking notification email
HOMESTAY_EMAIL=stayhostelbar@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@phongtzzz.local
SMTP_FROM_NAME=Phongtzzz Booking
SMTP_USE_TLS=true

# Cloudinary upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=phongtzzz
