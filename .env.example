# =========================================================
# Homestay Booking - optional root environment file
# Docker Compose works without .env using localhost defaults.
# For a real domain/server, copy this file to .env and edit values.
# =========================================================

PROJECT_NAME=riverside_haven
LANDING_PORT=5173
ADMIN_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# First empty-DB startup only:
# booking = sample homestay landing + rooms + Ha Giang Loop tours + media
# blank   = empty editable shell, no demo rooms/tours/media
# Changing this later does NOT overwrite an initialized database.
INITIAL_SITE_TEMPLATE=booking

# Public URLs. For local-only use, set localhost values shown below.
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Cloudflare Tunnel (optional: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_DB=riverside_haven
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# FastAPI / Auth
APP_NAME=Riverside Haven Booking API
ENVIRONMENT=production
SECRET_KEY=change-this-secret-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@riversidehaven.local
ADMIN_PASSWORD=admin123456

# CORS - comma separated extra origins
CORS_EXTRA_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Room + tour booking notification email (optional)
HOMESTAY_EMAIL=stayhostelbar@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@riversidehaven.local
SMTP_FROM_NAME=Riverside Haven Booking
SMTP_USE_TLS=true

# Media is local and persistent. Docker maps:
#   ./data/uploads (host) <-> /data/uploads (API)
# No Cloudinary credentials are required.
